PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:5173

# Get this from your Supabase project: Project Settings -> Database ->
# Connection string -> URI (use the "Connection pooling" string for
# production hosts like Render). Required both locally and in production --
# there is no local-file fallback anymore, the app always talks to Postgres.
DATABASE_URL=postgres://postgres:your-password@your-project.supabase.co:5432/postgres
